---
import SectionLabel from "../components/SectionLabel.astro";
import Schedule from "../components/Schedule.astro";
import {
  ChevronDown,
  MapPin,
  CalendarDays,
  Sparkles,
  Music2,
  Gift,
} from "lucide-astro";
import CountDown from "./CountDown.astro";

const daySchedule = [
  ["12:00 hs", "Civil + bendición"],
  ["13:30 hs", "Recepción y tapeo"],
  ["14:00 hs", "Almuerzo de 3 pasos"],
  ["16:00 hs", "Brindis y torta"],
  ["17:00 hs", "Café de finalización"],
];

const nightSchedule = [
  ["19:00 hs", "Tapeo, tragos y música"],
  ["21:00 hs", "DJ, luces y celebración"],
  ["22:00 hs", "Continúa el tapeo"],
  ["00:00 hs", "Cierre final"],
];
---

<main>
  <section class="hero" id="inicio">
    <div class="hero-wash"></div>
    <nav class="nav shell" aria-SectionLabel="Navegación principal">
      <a class="monogram" href="#inicio" aria-SectionLabel="Julieta y Ezequiel"
        >J<span>&</span>E</a
      >
      <div class="nav-links">
        <a href="#celebracion">Celebración</a>
        <a href="#regalos">Regalos</a>
        <a href="#confirmar">Confirmar asistencia</a>
      </div>
    </nav>
    <div class="hero-content shell">
      <div class="eyebrow"><span></span> 06 · 12 · 2026 <span></span></div>
      <p class="hero-kicker">Con mucha alegría</p>
      <h1>Julieta <em>&</em><br />Ezequiel</h1>
      <p class="hero-message">
        Te invitamos a nuestro festejo,<br class="desktop-break" /> queremos que seas
        parte.
      </p>
      <a href="#celebracion" class="scroll-cue" aria-SectionLabel="Ver detalles"
        ><ChevronDown size={18} /></a
      >
    </div>
    <div class="hero-ornament" aria-hidden="true">✳</div>
  </section>
  <CountDown />
  <section class="intro section-pad shell">
    <SectionLabel>Nuestra boda</SectionLabel>
    <div class="intro-grid">
      <h2>Un día para<br /><em>recordar siempre.</em></h2>
      <div>
        <p class="lead">
          Un día completo al aire libre, en contacto con la naturaleza, con menú
          criollo a las brasas y un festejo nocturno para celebrar juntos.
        </p>
        <div class="details-line">
          <MapPin size={17} /><span
            >El Campito Eventos Ibarlucea<br />Ruta 34 S y Los Naranjos, Santa
            Fe</span
          >
        </div>
      </div>
    </div>
    <div class="info-strip">
      <div>
        <CalendarDays size={20} /><span
          ><small>Fecha</small>6 de diciembre de 2026</span
        >
      </div>
      <div>
        <Sparkles size={20} /><span><small>Código de vestimenta</small>Elegante Sport</span
        >
      </div>
      <div>
        <Music2 size={20} /><span><small>Temática</small>Día de campo</span>
      </div>
    </div>
  </section>

  <section class="celebration section-pad" id="celebracion">
    <div class="shell">
      <SectionLabel>Acerca de la celebración</SectionLabel>
      <div class="section-heading">
        <h2>Momentos que vamos<br /><em>a compartir</em></h2><p>
          Una celebración en dos tiempos,<br />pensada para disfrutar sin apuro.
        </p>
      </div>
      <div class="timeline-grid">
        <article class="moment-card day-card">
          <div class="moment-top">
            <span class="moment-type">01 / DAY</span><span class="moment-mark"
              >☼</span
            >
          </div><h3>Ceremonia <em>&</em><br />Almuerzo Criollo</h3><Schedule
            items={daySchedule}
          />
        </article>
        <article class="break-card">
          <div class="break-icon">◌</div><h3>Break</h3><p>
            Descanso para la<br />segunda parte
          </p><span>17:00 — 19:00 hs</span><small>Continúa la celebración</small
          >
        </article>
        <article class="moment-card night-card">
          <div class="moment-top">
            <span class="moment-type">02 / NIGHT</span><span class="moment-mark"
              >✦</span
            >
          </div><h3>Previa <em>&</em><br />Party</h3><Schedule
            items={nightSchedule}
          />
        </article>
      </div>
    </div>
  </section>

  <section class="gift section-pad shell" id="regalos">
    <div class="gift-copy">
      <SectionLabel>Gift registry</SectionLabel>
	  <h2>
        Tu presencia es<br /><em>nuestro mejor regalo.</em>
      </h2>
    </div>
    <div class="gift-card">
      <p>
        También podés acompañarnos<br />en el comienzo de nuestra vida<br />de
        casados.
      </p><div
        class="qr-placeholder"
        aria-SectionLabel="Código QR para contribuciones"
      >
        <span>QR</span>
      </div><small
        >Escaneá el QR o escribinos a<br />hello@reallygreatsite.com</small
      >
    </div>
  </section>

  <section class="rsvp" id="confirmar">
    <div class="shell rsvp-inner">
      <SectionLabel>Un último detalle</SectionLabel><h2>¿Nos acompañás?</h2><p>
        Confirmar asistencia antes del<br /><strong>6 de noviembre 2026</strong>
      </p><a
        class="button"
        href="mailto:hello@reallygreatsite.com?subject=Confirmación%20de%20asistencia"
        >Confirmar asistencia <span>↗</span></a
      >
    </div>
  </section>

  <footer class="footer shell">
    <div class="monogram">J<span>&</span>E</div><p>
      “Por encima de todo, vístanse de amor,<br />que es el vínculo perfecto.”
    </p><span>Colosenses 3:14</span>
  </footer>
</main>
