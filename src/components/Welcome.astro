---
import SectionLabel from "../components/SectionLabel.astro";
import Schedule from "../components/Schedule.astro";
import {
  ChevronDown,
  MapPin,
  CalendarDays,
  Sparkles,
  Music2,
  Gift,
} from "lucide-astro";
import CountDown from "./CountDown.astro";
import Footer from "./Footer.astro";
import Confirmation from "./Confirmation.astro";
import Gifts from "./Gifts.astro";
import Celebration, { type ScheduleItem } from "./Celebration.astro";

---

<main>
  <section class="hero" id="inicio">
    <div class="hero-wash"></div>
    <nav class="nav shell" aria-SectionLabel="Navegación principal">
      <a class="monogram" href="#inicio" aria-SectionLabel="Julieta y Ezequiel"
        >J<span>&</span>E</a
      >
      <div class="nav-links">
        <a href="#celebracion">Celebración</a>
        <a href="#regalos">Regalos</a>
        <a href="#confirmar">Confirmar asistencia</a>
      </div>
    </nav>
    <div class="hero-content shell">
      <div class="eyebrow"><span></span> 06 · 12 · 2026 <span></span></div>
      <p class="hero-kicker">Con mucha alegría</p>
      <h1>Julieta <em>&</em><br />Ezequiel</h1>
      <p class="hero-message">
        Te invitamos a nuestro festejo,<br class="desktop-break" /> queremos que seas
        parte.
      </p>
      <ChevronDown size={18} />
    </div>
    <div class="hero-ornament" aria-hidden="true">✳</div>
  </section>
  <CountDown />
  <section class="intro section-pad shell" id="nuestra-boda">
    <SectionLabel>Nuestra boda</SectionLabel>
    <div class="intro-grid pt-8">
      <div>
        <h2 class="text-[var(--olive)]">Un día para<br /><em>recordar siempre.</em></h2>
        <div class="pt-8">
          <p class="text-balance">
            Un día completo al aire libre en contacto con la naturaleza, con
            menú criollo a las brasas y un festejo nocturno para celebrar
            juntos.
          </p>
          <div class="details-line pt-4">
            <MapPin size={17} /><span
              >El Campito Eventos Ibarlucea<br />Ruta 34 S y Los Naranjos, Santa
              Fe</span
            >
          </div>
		  <iframe class="aspect-video mt-12" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3351.720829205909!2d-60.771221499999996!3d-32.852642599999996!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95b64f20593e7f25%3A0x56c5ed44a28e10b8!2sEl%20Campito%20Eventos!5e0!3m2!1ses-419!2sar!4v1787774806598!5m2!1ses-419!2sar" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
      </div>
      <video
        class="w-full "
        crossorigin="anonymous"
        src="/dia.mp4"
        autoplay
        muted
        loop></video>
    </div>
    <div class="info-strip">
      <div>
        <CalendarDays size={20} /><span
          ><small>Fecha</small>6 de diciembre de 2026</span
        >
      </div>
      <div>
        <Sparkles size={20} /><span
          ><small>Código de vestimenta</small>Elegante Sport</span
        >
      </div>
      <div>
        <Music2 size={20} /><span><small>Temática</small>Día de campo</span>
      </div>
    </div>
  </section>

  <Celebration />

  <Gifts />

  <Confirmation />

  <Footer />
</main>
