---
import type { ScheduleItem } from './Celebration.astro';

interface Props {
  items: ScheduleItem[];
}
const { items } = Astro.props;
---
<div class="schedule">
  {items.map(({ time, description }) => (
    <div class="schedule-row">
      <span>{time}</span>
      <strong>{description}</strong>
    </div>
  ))}
</div>