---
import SectionLabel from "./SectionLabel.astro";
import RsvpModal from "./RsvpModal.astro";
---

<section class="rsvp" id="confirmar">
  <div class="shell rsvp-inner">
    <SectionLabel>Un último detalle</SectionLabel>
    <h2>¿Nos acompañás?</h2>
    <p class=" text-center mx-auto">
      Necesitamos tu confirmación tan pronto como sea posible.
    </p>
    <button class="button cursor-pointer" id="confirmar-btn"
      >Confirmar asistencia <span>↗</span></button
    >
  </div>
</section>
<RsvpModal />